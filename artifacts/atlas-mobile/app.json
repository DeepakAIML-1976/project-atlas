{
  "expo": {
    "name": "Atlas Mobile",
    "slug": "atlas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/atlas-brand-icon.png",
    "splash": {
      "image": "./assets/images/atlas-brand-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f2ea"
    },
    "scheme": "atlas-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/atlas-brand-icon.png",
        "backgroundColor": "#f5f2ea"
      }
    },
    "web": {
      "favicon": "./assets/images/atlas-brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/atlas-brand-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f5f2ea"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}